# Shop Clock env vars
# Copy to .env.local and fill in.

# Postgres (Neon). On Vercel set DATABASE_URL to the pooled connection string.
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# Printavo GraphQL API — v2
# See C:\Dev\hq-print\scripts\enrich-printavo-garments.ts for reference.
# Auth is two headers: `email` + `token` (NOT Authorization).
PRINTAVO_API_URL="https://www.printavo.com/api/v2"
PRINTAVO_API_EMAIL="eric@craft-mfg.com"
PRINTAVO_API_TOKEN=""

# Admin sign-in — gates /admin/* and mutating /api/operators routes.
# Pick any strong password + a long random SESSION_SECRET (32+ chars).
# Rotating SESSION_SECRET invalidates everyone's admin cookies.
ADMIN_PASSWORD=""
SESSION_SECRET=""

# HQ Print integration — wires completed time entries into HQ TimeEntry.
# HQ_API_URL: base URL of your HQ Print deployment (no trailing slash).
# HQ_INGEST_SECRET: must match SHOP_CLOCK_INGEST_SECRET in HQ's env.
# HQ_TENANT_ID: your HQ tenant ID (numeric).
# NEXT_PUBLIC_HQ_API_URL: same as HQ_API_URL but exposed to the browser
#   (used by the /change-pin page to call HQ's /api/scan/change-pin).
HQ_API_URL=""
HQ_INGEST_SECRET=""
HQ_TENANT_ID=""
NEXT_PUBLIC_HQ_API_URL=""
